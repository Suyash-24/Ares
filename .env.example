# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_PREFIX=.
OWNER_IDS=your_user_id_here,another_owner_id
LAVALINK_NODES=[{"name":"Prime-DE","host":"de-01.strixnodes.com","port":2010,"password":"glace","secure":false},{"name":"Prime-US","host":"us-01.strixnodes.com","port":8003,"password":"glace","secure":false}]
LAVALINK_PUBLIC_FALLBACK=true
LAVALINK_ALLOW_LOCALHOST=false
DISABLE_POSTGRES=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Database Configuration (PostgreSQL - Primary)
# Leave empty to skip PostgreSQL and use fallback (SQLite or JSON)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Note: The bot will automatically try:
# 1. PostgreSQL (if configured)
# 2. SQLite (as fallback)
# 3. JSON file (as final fallback)

# Dashboard Configuration
# Set DISCORD_CLIENT_SECRET to enable the web dashboard
# Get your client secret from https://discord.com/developers/applications
DISCORD_CLIENT_SECRET=your_client_secret_here
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_random_string
SESSION_STORE_DIR=./data/sessions
